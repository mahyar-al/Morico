# ==============================================================================
# MORICOLAND (MORICO STYLE) — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` locally (never commit `.env` to git) or configure
# these variables directly inside cPanel -> "Setup Node.js App" -> Environment variables.
# On cPanel/Passenger, keeping secrets in cPanel's Node App UI outside webroot is recommended.

# --- 1. Runtime & Domain ---
# محیط اجرا: روی سرور عملیاتی حتماً production و در توسعه development باشد
NODE_ENV=production
# پورت اجرای سرویس Express (در cPanel معمولاً خود Passenger مقداردهی می‌کند؛ پیش‌فرض محلی ۳۰۰۰)
PORT=3000
# آدرس عمومی پایه سایت با HTTPS (بدون اسلش انتهایی) - مبنای ساخت آدرس Callback پیش‌فرض
APP_BASE_URL=https://moricoland.ir
# دامنه‌های مجاز برای CORS و بررسی Origin/Referer (با کاما جدا شوند)
ALLOWED_ORIGINS=https://moricoland.ir,https://www.moricoland.ir

# --- 2. Persistent Storage Outside App Root (B1) ---
# مسیر نگهداری orders/users/products/audit JSON — روی cPanel بیرون از پوشه اپ بگذارید تا با آپلود نسخه جدید پاک نشود
DATA_DIR=./data
# مسیر نگهداری تصاویر آپلودی محصولات و فایل‌های طراحی اختصاصی مشتریان (designs/)
UPLOADS_DIR=./public/uploads

# --- 3. Admin Auth, Sessions & Security ---
# نام کاربری و رمز عبور قوی مدیر (در production باید تنظیم شوند؛ حداقل ۱۲ کاراکتر قوی)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# کلید امضای توکن‌های JWT/JOSE و کوکی‌ها (حداقل ۳۲ کاراکتر تصادفی با openssl rand -hex 32)
SESSION_SECRET=
# هشدار: در حال حاضر UI برای ورود/راه‌اندازی MFA در پنل ادمین وجود ندارد؛ تا زمان افزوده‌شدن UI حتماً false بماند (true باعث قفل‌شدن مسیرهای ادمین با 403 می‌شود)
REQUIRE_ADMIN_MFA=false
# اختیاری: آدرس Redis در صورت نیاز به ذخیره متمرکز Rate Limit و JTI Revocation
REDIS_URL=

# --- 4. ZarinPal v4 Payment Gateway ---
# حالت درگاه: sandbox (تست سندباکس) یا production (درگاه واقعی)
# نکته امنیتی A2: در NODE_ENV !== production استفاده از ZARINPAL_MODE=production مسدود می‌شود
ZARINPAL_MODE=sandbox
# شناسه پذیرنده ۳۶ کاراکتری UUID دریافتی از پنل زرین‌پال (هرگز در کد یا گیت قرار ندهید)
ZARINPAL_MERCHANT_ID=
# آدرس بازگشت ثابت HTTPS درگاه (اختیاری اگر APP_BASE_URL تنظیم شده باشد، ولی در production الزامی است یکی معتبر و HTTPS باشد)
ZARINPAL_CALLBACK_URL=https://moricoland.ir/api/payments/zarinpal/callback